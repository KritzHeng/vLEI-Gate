# vLEI-Gate configuration. Copy to `.env` (repo root) and fill in.
#   cp .env.example .env
# The backend loads this file through backend/app/config.py (variables already set
# in the shell take precedence). Foundry reads it for `forge script` from contracts/
# only if you export it first:  set -a; source ../.env; set +a
# NEVER commit `.env`. Every key below is a secret unless noted otherwise.

# ---------------------------------------------------------------- chain
# RPC for BSC Testnet (Chapel, chainId 97). Flap's name, read by the fork tests
# (test/fork/*.fork.t.sol) and by scripts/e2e_local.py as the anvil --fork-url source
# (default https://bsc-testnet-rpc.publicnode.com).
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Same RPC under this project's older name. Used by forge (foundry.toml rpc_endpoints), accepted by the
# fork tests / e2e as a fallback, and by backend/scripts/revoke_and_push.py when RPC_URL is unset.
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Optional, for `forge script ... --verify`.
BSCSCAN_API_KEY=
# Chain the backend signs attestations for (EIP-712 domain chainId). 97 = BSC Testnet, and also an anvil
# fork of it (`anvil --fork-url $BSC_TESTNET_RPC_URL` keeps chainId 97).
CHAIN_ID=97
# RPC the backend uses to read registry.nonces(wallet) on-chain when signing attestations
# (the client-supplied registryNonce is then ignored). Also used by revoke_and_push.py,
# which falls back to BSC_TESTNET_RPC.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# ---------------------------------------------------------------- deployment (contracts/script/Deploy.s.sol)
# Deployer key. Becomes registry admin and factory owner unless ADMIN_ADDRESS is set. SECRET.
DEPLOYER_PRIVATE_KEY=
# Optional: separate admin (revocation, verifier rotation, factory owner). Default: deployer.
ADMIN_ADDRESS=
# Optional: admin key used by backend/scripts/revoke_and_push.py --push. Default: DEPLOYER_PRIVATE_KEY. SECRET.
ADMIN_PRIVATE_KEY=
# Optional: verifier signer address granted VERIFIER_ROLE. Default: address of VERIFIER_PRIVATE_KEY.
VERIFIER_ADDRESS=
# v1 BNB factory only (script/Deploy.s.sol): aggregator-style feed; empty => MockPriceFeed.
# The live Atlas feed for the v2 BNB factory is ATLAS_SIGNED_FEED_ADDRESS (see README §4.3).
ATLAS_FEED_ADDRESS=
# Max age of the feed answer in seconds before contributions revert with StalePrice. Default 3600.
# The MockPriceFeed goes stale after this and only its deployer can refresh it (setAnswer).
MAX_PRICE_AGE=3600
# Flap Portal (same address on BNB Chain and BNB Testnet). Empty => this default.
FLAP_PORTAL=0x000042108465206185A077Edc3F3fd2b49060000
# Flap Guardian: the only account that can upgrade our launcher implementation. Empty => per-chain default
# (testnet 0x00004d58290854c5E9880F4b5B1993c6Ad8b0000).
FLAP_GUARDIAN=
# Output of Deploy.s.sol, relative to contracts/ and inside contracts/deployments/. Empty =>
# ./deployments/<chainId>.json. On an anvil fork use ./deployments/97-fork.json so 97.json is not overwritten.
DEPLOYMENTS_FILE=

# ---------------------------------------------------------------- backend verifier (backend/app/config.py)
# Key that signs EIP-712 attestations. Its address must hold VERIFIER_ROLE on the registry. SECRET.
VERIFIER_PRIVATE_KEY=
# VLEIRegistry address. Empty => read from contracts/deployments/<CHAIN_ID>.json.
REGISTRY_ADDRESS=
# Pinned root AID. Empty => backend/data/root.json (test root from scripts/make_test_chain.py).
# In production this is GLEIF's root AID.
PINNED_ROOT_AID=
# Comma-separated HTTP watcher URLs (reserved; this build reads the local watcher store in backend/data/watcher).
WATCHER_URLS=
# Optional: alternate data dir (keystore, watcher, wallets, root.json). Default backend/data.
# Read before .env is loaded, so set it in the shell environment (tests and scripts/e2e_local.py do).
# VLEI_DATA_DIR=/path/to/data
# Lifetime of a signed attestation (seconds, registry caps it at 30 days) and of a challenge.
ATTESTATION_TTL_SECONDS=86400
CHALLENGE_TTL_SECONDS=300
# OOR officialRole values allowed to create a launcher (comma-separated, case-insensitive).
LAUNCH_OFFICIAL_ROLES="Chief Executive Officer,Chief Financial Officer,Chief Operating Officer,Managing Director,CEO,CFO,COO"
# DEMO ONLY. Demo holder agent (/api/demo/*) that signs challenges with the test personas' KERI keys.
# The backend defaults to false; never enable it on a deployment that holds real credentials.
ENABLE_DEMO_AGENT=true
# Allowed browser origins (comma-separated).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- market data
# CoinMarketCap Pro API key (server-side only, proxied at GET /api/market/cmc). SECRET.
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# ---------------------------------------------------------------- Atlas signed feed (scripts/push_atlas_price.py)
# Atlas Oracle Pull API key (server-side only; used to fetch signed reports). SECRET.
ATLAS_API_KEY=
# Atlas feedId of BNB/USD (the "feedId" string the Pull API takes, e.g. "624" in the Atlas docs is NOT BNB).
# Also read by contracts/script/DeployAtlasFeed.s.sol; empty => the feed is deployed unset and
# `push_atlas_price.py --set-feed-id` sets it (owner only, before the first submit).
ATLAS_BNB_FEED_ID=
# AtlasSignedFeed address (not secret). Empty => contracts/deployments/<CHAIN_ID>-atlas.json .atlasSignedFeed.
# BSC testnet: 0x34aa570cDa23282af94aA3CE4232bD4B18B644d5
ATLAS_SIGNED_FEED_ADDRESS=
# Atlas vs CoinMarketCap cross-check (backend /api/market/price-check and the relayer)
# PRICE_DEVIATION_MAX_BPS=200
# PRICE_MAX_AGE_SECONDS=3600

# ---------------------------------------------------------------- Cournot Intelligence Oracle (rate risk)
# Live calls to https://interface.cournot.ai/intelligence/v1/{resolve,probability}. No mock.
# Without a key Cournot's free quota applies (3 probability calls per IP); a pack key goes in COURNOT_API_KEY.
# Each live call is logged (IP redacted) to logs/cournot/live/; the UI reuses the latest one unless refreshed.
COURNOT_API_KEY=
# COURNOT_API_BASE=https://interface.cournot.ai
# COURNOT_QUESTION=Will the 10-year US Treasury yield be above 4.74% on December 31, 2026?
# COURNOT_MARKET_IDS=2878523
# COURNOT_MIN_REFRESH_SECONDS=300   # server-side throttle on live calls
# Probability at or above which investors must acknowledge the rate-risk notice before contributing.
COURNOT_RISK_THRESHOLD=0.5

# ---------------------------------------------------------------- frontend (public, exposed to the browser)
# Never put secrets in NEXT_PUBLIC_* variables. Next.js only reads env files from its own
# directory, so put these in frontend/.env.local (listed here so one file documents everything).
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_REGISTRY_ADDRESS=
# VLEILauncherFactory ("factory" in the deployments JSON)
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_PORTAL_ADDRESS=0x000042108465206185A077Edc3F3fd2b49060000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
