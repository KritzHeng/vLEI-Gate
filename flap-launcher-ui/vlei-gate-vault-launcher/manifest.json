{
  "schemaVersion": 2,
  "kind": "launcher-ui",
  "artifactId": "vlei-gate-vault-launcher",
  "name": "vLEI-Gate Verified Entity Raise (USDT) + Gated Yield",
  "chainId": 97,
  "factoryAddress": "0xEA3d889e5EA5f684268cDEcc45CE77322F0D9CeD",
  "configContract": "launcher-config-preview/v1",
  "surfaces": ["launcher-config", "launcher-ui"],
  "entry": "Component.tsx",
  "reads": {
    "status": { "functionName": "status", "returns": "uint256" },
    "raised": { "functionName": "raised", "returns": "uint256" },
    "targetRaise": { "functionName": "targetRaise", "returns": "uint256" },
    "saleDeadline": { "functionName": "saleDeadline", "returns": "uint256" },
    "vault": { "functionName": "vault", "returns": "address" },
    "creatorActive": { "functionName": "creatorActive", "returns": "bool" },
    "capUsdPerEntity": { "functionName": "capUsdPerEntity", "returns": "uint256" },
    "token": { "functionName": "token", "returns": "address" },
    "quoteToken": { "functionName": "quoteToken", "returns": "address" },
    "contribution": { "functionName": "contributionOf", "returns": "uint256", "account": true },
    "claimable": { "functionName": "claimableOf", "returns": "uint256", "account": true },
    "remainingCapUsd": { "functionName": "remainingCapUsd", "returns": "uint256", "account": true },
    "vleiStatus": { "functionName": "vleiStatusOf", "returns": "uint256", "account": true },
    "allowance": { "functionName": "allowanceOf", "returns": "uint256", "account": true },
    "quoteBalance": { "functionName": "quoteBalanceOf", "returns": "uint256", "account": true },
    "previewContribute": { "functionName": "previewContribute", "returns": "uint256", "account": true }
  },
  "transactions": {
    "create": true,
    "actions": {
      "contribute": "payable",
      "claim": "nonpayable",
      "refund": "nonpayable",
      "withdrawContribution": "nonpayable",
      "cancelIfCreatorRevoked": "nonpayable"
    }
  }
}
